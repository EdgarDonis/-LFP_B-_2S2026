## Prueba 07 - Comentarios, lineas en blanco y tabuladores
## Objetivo: validar que los comentarios de linea, los saltos de linea y los
## tabuladores se manejen como delimitadores silenciosos (no generan token,
## pero deben actualizar correctamente los contadores de linea/columna).
## Resultado esperado: 0 errores, 0 choques; el archivo es valido a pesar del
## formato irregular.

## Este es un comentario antes del bloque principal
HORARIO {

	## Comentario indentado con tabulador
	CURSOS {
		curso: "Etica y Cultura de Paz"		[codigo: "ETI-0101", creditos: 2],

		curso: "Fisica Basica 1"	[codigo: "FIS-0100", creditos: 3],
	};

    CATEDRATICOS {
        catedratico: "Ana Lucia Solis" [codigo: "DOC-201", categoria: AUXILIAR],
    };

	## Aulas del edificio T-1
    AULAS {
        aula: "T1-005" [capacidad: 45, edificio: "T-1"],
    };

    CLASES {
        ## Clase de los lunes
        clase: "ETI-0101" con "DOC-201" en "T1-005" [dia: LUNES, inicio: 07:00, fin: 07:50, seccion: "N"],

        ## Clase de los miercoles, con tabulador antes del cierre
        clase: "FIS-0100" con "DOC-201" en "T1-005" [dia: MIERCOLES, inicio: 07:00, fin: 08:40, seccion: "N"],
	};
};
