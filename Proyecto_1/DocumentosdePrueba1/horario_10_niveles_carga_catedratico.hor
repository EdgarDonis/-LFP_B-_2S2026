## Prueba 10 - Niveles de carga de catedratico (Reporte 2)
## Objetivo: cubrir los 4 umbrales sugeridos en la seccion 4.7 (Reporte 2):
## BAJA (1-4h), NORMAL (5-10h), ALTA (11-15h) y SATURADA (16+h).
## - DOC-301 "Carga Baja": 1 clase de 1h40 => BAJA
## - DOC-302 "Carga Normal": 4 clases de 1h40 => 6h40 => NORMAL
## - DOC-303 "Carga Alta": 8 clases de 1h40 => 13h20 => ALTA
## - DOC-304 "Carga Saturada": 10 clases de 1h40 => 16h40 => SATURADA
## Resultado esperado: el Reporte 2 debe mostrar cada catedratico con el color
## de nivel de carga correspondiente (azul, verde, naranja, rojo).

HORARIO {
    CURSOS {
        curso: "Curso Carga A" [codigo: "CGA-001", creditos: 3],
    };
    CATEDRATICOS {
        catedratico: "Carga Baja" [codigo: "DOC-301", categoria: AUXILIAR],
        catedratico: "Carga Normal" [codigo: "DOC-302", categoria: INTERINO],
        catedratico: "Carga Alta" [codigo: "DOC-303", categoria: TITULAR],
        catedratico: "Carga Saturada" [codigo: "DOC-304", categoria: TITULAR],
    };
    AULAS {
        aula: "C-301" [capacidad: 30, edificio: "T-2"],
    };
    CLASES {
        clase: "CGA-001" con "DOC-301" en "C-301" [dia: LUNES, inicio: 07:00, fin: 08:40, seccion: "N"],

