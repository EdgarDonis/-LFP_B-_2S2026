        clase: "CGA-001" con "DOC-303" en "C-301" [dia: LUNES, inicio: 11:00, fin: 12:40, seccion: "B"],
        clase: "CGA-001" con "DOC-303" en "C-301" [dia: MARTES, inicio: 11:00, fin: 12:40, seccion: "B"],
        clase: "CGA-001" con "DOC-303" en "C-301" [dia: MIERCOLES, inicio: 11:00, fin: 12:40, seccion: "B"],
        clase: "CGA-001" con "DOC-303" en "C-301" [dia: JUEVES, inicio: 11:00, fin: 12:40, seccion: "B"],
